# Copy this file to .env.local and fill in your real values.
#
# The same four required values go into your hosting provider's environment
# settings (on Vercel: Project → Settings → Environment Variables). .env.local
# is git-ignored and never leaves your machine, so it does NOT reach production.
#
# ── REQUIRED ────────────────────────────────────────────────────────────────


# 1. Your WordPress site's Kandi API base, with no trailing slash.
#    Everything the shop knows — products, orders, sellers, payments — comes
#    through here.
WP_API_URL=https://shop.kandiug.com/wp-json/kandi/v1


# 2. The shared secret, matching the one in WordPress.
#    Set it in wp-config.php as `define( 'KANDI_API_SECRET', '…' );` or under
#    wp-admin → Kandi Storefront → Storefront connection. Every order, seller
#    and payment request carries it, so only your shop can reach those
#    endpoints. Make it long and random.
KANDI_API_SECRET=


# 3. The storefront's public URL, no trailing slash — e.g. https://kandiug.com
#
#    Pesapal builds its callback from it, and SEARCH ENGINES NEED IT MORE:
#    every canonical tag, every URL in sitemap.xml and every Open Graph image is
#    built from this value. Left blank outside Vercel it falls back to
#    http://localhost:3000, and the live site then tells Google its real pages
#    are duplicates of an address nobody can reach — indistinguishable from
#    asking not to be indexed at all.
#
#    Vercel fills this in by itself from the deployment URL. On a custom domain,
#    or any other host, set it by hand and check https://your-site/sitemap.xml
#    afterwards: if the URLs in it say localhost, this is why.
NEXT_PUBLIC_SITE_URL=https://kandiug.com


# 4. Google sign-in. Create an OAuth 2.0 Web client at
#    https://console.cloud.google.com/apis/credentials and add BOTH origins to
#    "Authorised JavaScript origins" — http://localhost:3000 and your live
#    domain — or the button fails on whichever is missing.
#
#    Without this, shopper sign-in, the account dashboard, seller Google
#    sign-in and writing reviews are all unavailable.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ── OPTIONAL ────────────────────────────────────────────────────────────────


# Better address lookup at checkout.
#
# With no key the shop uses OpenStreetMap's Nominatim: free, no account, and
# good enough. A Google Maps key reads Ugandan street addresses better and
# returns a tidier label. Either way the delivery *price* is calculated from
# coordinates, so this only affects the name shown back to the shopper.
GOOGLE_MAPS_API_KEY=


# ── PESAPAL: NOT SET HERE ANY MORE ──────────────────────────────────────────
#
# Card and mobile money now run entirely inside WordPress, in the Kandi Pesapal
# plugin. The keys live at wp-admin → Kandi Storefront → Pesapal, and that
# screen has a "Test Pesapal connection" button that says exactly which step
# fails when something is wrong.
#
# They moved because calling Pesapal from a serverless function on this host
# killed the function before it could answer: the shopper saw a bare 502 with
# no message and nothing was written to any log. WordPress is an ordinary PHP
# process with no execution ceiling and a readable log, it already holds the
# order being paid for, and Pesapal's IPN can call it directly.
#
# The four variables below are a fallback for a deployment whose WordPress does
# not have the Kandi Pesapal plugin yet. If yours does — and it should — leave
# them empty or delete them; anything set here is ignored.
#
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_IPN_ID=


# ── HARDENING: STRONGLY RECOMMENDED BEFORE A REAL LAUNCH ────────────────────
#
# None of the four blocks below is required to run the shop, and every one of
# them changes what an attacker can do to it. They are listed in the order
# worth setting them.


# 1. SHARED RATE LIMITING AND IDEMPOTENCY  (Upstash Redis)
#
#    Without these, both the rate limiter (`lib/rate-limit.ts`) and the
#    idempotency store (`lib/idempotency.ts`) keep their state in one server
#    process's memory. That has two honest limits: on a serverless deployment
#    each warm instance counts separately, so the effective limit is the
#    configured one times the number of instances; and a cold start forgets
#    everything.
#
#    It catches the double tap and the browser retry — both land on the same
#    warm instance seconds apart — and it does not reliably catch a shopper
#    whose connection stalled and who retried a minute later against a
#    different instance. That case creates a duplicate order.
#
#    Set these and both become shared and durable. Free tier at
#    https://console.upstash.com — create a Redis database, copy the two REST
#    values off its dashboard.
#
#    This is NOT a substitute for a WAF. Cloudflare's or Vercel's own rate
#    limiting in front of the origin stops a flood before it costs a function
#    invocation; this stops what gets through.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# 2. BOT PROTECTION ON CHECKOUT  (Cloudflare Turnstile)
#
#    Checkout creates real WooCommerce orders from an unauthenticated POST.
#    Until both of these are set there is no bot check on it — only the rate
#    limit and the item caps.
#
#    Cloudflare dashboard → Turnstile → Add site, for this shop's domain. Use
#    the "Managed" mode: most shoppers never see a challenge at all, which
#    matters on the one screen where an interruption costs a sale.
#
#    The site key is public and ships in the browser bundle; that is what it is
#    for. The secret key is server-only — never give it a NEXT_PUBLIC_ prefix.
#
#    If Cloudflare is unreachable the server lets the request through rather
#    than failing the sale; see `lib/turnstile.ts` for why.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# 3. SESSION ENCRYPTION  (owner sign-in)
#
#    The owner's session cookie is AES-256-GCM ciphertext with a twelve-hour
#    expiry sealed inside it. It used to be the owner passcode in plain text,
#    valid for thirty days — see `lib/sealed-cookie.ts`.
#
#    Unset, the key is derived from KANDI_API_SECRET, which works. Setting a
#    separate one is better: a session key and a backend key should not be able
#    to compromise each other. Long and random, like KANDI_API_SECRET.
#
#    Rotating this signs every owner out immediately, which is the only
#    revocation this scheme has. Worth knowing before you need it.
KANDI_SESSION_SECRET=


# 4. PAYMENT AUTHORISATION KEY
#
#    Signs the token that proves whoever is starting a payment is the person
#    who placed the order. Without one, `/api/payments/pesapal/start` took a
#    bare WooCommerce order id — and those are sequential, so a loop could open
#    a payment against any order in the shop and read that buyer's name, email,
#    phone and address out of the reply. See `lib/checkout-token.ts`.
#
#    Unset, it falls back to KANDI_API_SECRET, so payments keep working with no
#    action needed. A separate key is better for the same reason as above.
KANDI_CHECKOUT_SECRET=

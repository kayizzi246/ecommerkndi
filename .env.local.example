# Copy this file to .env.local and fill in your real values.

# Your WordPress site's custom API base (no trailing slash)
WP_API_URL=https://yourwordpresssite.com/wp-json/kandi/v1

# Must match the KANDI_API_SECRET defined in wp-config.php
KANDI_API_SECRET=change-me-to-a-long-random-string

# Owner product manager at /admin — add, edit and delete ANY product in the shop
# without a seller account. This value is NOT read by the storefront: it is only
# ever typed into the sign-in form and checked against wp-config.php, so it must
# match the KANDI_OWNER_PASSCODE defined there. Leave the WordPress side unset
# and owner access stays switched off entirely.

# ---------------------------------------------------------------- Pesapal
# Card and mobile money payments, at checkout and for the seller joining fee.
# Leave these blank and the shop quietly falls back to cash on delivery only —
# the card / mobile money options appear disabled rather than failing on submit.
#
# Get your keys from https://www.pesapal.com (Merchant account → API keys), or
# download the sandbox test credentials from their developer docs.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=

# "sandbox" (default) or "live". ANYTHING other than the exact word "live" stays
# on the sandbox — defaulting the other way would mean a typo takes real money.
PESAPAL_ENV=sandbox

# Optional. The storefront registers its own IPN URL on first use and reuses the
# existing registration afterwards, so this is only needed if you want to pin a
# specific one from your Pesapal dashboard.
PESAPAL_IPN_ID=

# Your storefront's public URL, with no trailing slash — e.g. https://kandiug.com
#
# Pesapal needs it to build the callback and IPN addresses, and SEARCH ENGINES
# NEED IT MORE: every canonical tag, every URL in sitemap.xml and every Open
# Graph image is built from this value. Left blank outside Vercel it falls back
# to http://localhost:3000, and the live site then tells Google that its real
# pages are duplicates of an address nobody can reach — which is indistinguishable
# from asking not to be indexed at all.
#
# Vercel fills this in by itself from the deployment URL. On a custom domain,
# or any other host, set it by hand and check https://your-site/sitemap.xml
# afterwards: if the URLs in it say localhost, this is why.
NEXT_PUBLIC_SITE_URL=

# Google sign-in. Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials, add your site to
# "Authorised JavaScript origins" (e.g. http://localhost:3000 and your live
# domain), then paste the client ID here. Without it the sign-in button, the
# account dashboard and writing reviews are all unavailable.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
